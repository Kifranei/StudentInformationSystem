@model StudentInformationSystem.Models.ClassSessions

@{
    ViewBag.Title = "添加课程安排";
    var dayOptions = new[]
    {
        new { Value = "1", Text = "星期一" },
        new { Value = "2", Text = "星期二" },
        new { Value = "3", Text = "星期三" },
        new { Value = "4", Text = "星期四" },
        new { Value = "5", Text = "星期五" },
        new { Value = "6", Text = "星期六" },
        new { Value = "7", Text = "星期日" }
    };
    var periodOptions = Enumerable.Range(1, 12).Select(i => new { Value = i, Text = "第 " + i + " 节" });
}

<h2>添加课程安排</h2>
<hr />

<div class="alert alert-info">
    <h4><span class="glyphicon glyphicon-info-sign"></span> 分段排课说明</h4>
    <p>一门课程可以创建多个不同周次或节次的课程安排，系统会自动避开法定假日周次，并检测教师、教室和学生课表冲突。</p>
    <ul>
        <li><strong>示例一：</strong>第 1-4 周，星期三第 1-4 节，310 教室。</li>
        <li><strong>示例二：</strong>第 6-8 周，星期五第 5-8 节，308 教室。</li>
    </ul>
</div>

@{
    var holidayDescriptions = StudentInformationSystem.Helpers.HolidayHelper.GetHolidayWeekDescriptions();
    if (holidayDescriptions.Any())
    {
        <div class="alert alert-warning">
            <h5><span class="glyphicon glyphicon-calendar"></span> 本学期法定假日周次</h5>
            <p>这些周次为法定假日，课程安排会自动跳过。</p>
            <p>
                @foreach (var holiday in holidayDescriptions)
                {
                    <span class="label label-warning" style="margin-right: 8px;">第@(holiday.Key)周：@holiday.Value</span>
                }
            </p>
        </div>
    }
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.CourseID, "选择课程", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("CourseID", null, "-- 请选择课程 --", htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.CourseID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.StartWeek, "开始周次", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.StartWeek, new { htmlAttributes = new { @class = "form-control", @placeholder = "例如：1", @min = "1", @max = "21" } })
                @Html.ValidationMessageFor(model => model.StartWeek, "", new { @class = "text-danger" })
                <small class="text-muted">该时间安排的开始周次，范围 1-21 周。</small>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.EndWeek, "结束周次", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.EndWeek, new { htmlAttributes = new { @class = "form-control", @placeholder = "例如：4", @min = "1", @max = "21" } })
                @Html.ValidationMessageFor(model => model.EndWeek, "", new { @class = "text-danger" })
                <small class="text-muted">结束周次应大于或等于开始周次。</small>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DayOfWeek, "星期几", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.DayOfWeek, new SelectList(dayOptions, "Value", "Text"), "-- 请选择星期 --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.DayOfWeek, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.StartPeriod, "开始节次", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.StartPeriod, new SelectList(periodOptions, "Value", "Text"), "-- 请选择开始节次 --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.StartPeriod, "", new { @class = "text-danger" })
                <small class="text-muted">第 1 节 08:40-09:25，第 2 节 09:30-10:15，依次类推。</small>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.EndPeriod, "结束节次", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.EndPeriod, new SelectList(periodOptions, "Value", "Text"), "-- 请选择结束节次 --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.EndPeriod, "", new { @class = "text-danger" })
                <small class="text-muted">结束节次应大于或等于开始节次。</small>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Classroom, "教室", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Classroom, new { htmlAttributes = new { @class = "form-control", @placeholder = "例如：310、308、实验室A" } })
                @Html.ValidationMessageFor(model => model.Classroom, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="添加课程安排" class="btn btn-primary" />
                @Html.ActionLink("返回课表", "Timetable", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<style>
    .alert-info { background-color: #d9edf7; border-color: #bce8f1; color: #31708f; }
    .alert-warning { background-color: #fcf8e3; border-color: #faebcc; color: #8a6d3b; }
    .label { font-size: 85%; padding: 0.3em 0.6em; }
</style>
